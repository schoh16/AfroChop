{
  "name": "afrochef-connect",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:mobile": "npm --workspace @afrochef/mobile run start",
    "dev:api": "npm --workspace @afrochef/api run start:dev",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "db:generate": "npm --workspace @afrochef/api run prisma:generate",
    "db:migrate": "npm --workspace @afrochef/api run prisma:migrate",
    "db:seed": "npm --workspace @afrochef/api run prisma:seed"
  },
  "overrides": {
    "expo-font": "~57.0.4",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
