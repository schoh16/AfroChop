# Core app config
NODE_ENV=development
PORT=3000
# Amazon Cognito User Pool (API-only configuration; see infra/cognito.yaml).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Exact web origins allowed to manage cookie sessions. No trailing slashes.
CORS_ORIGINS=http://localhost:8082,http://localhost:8081

# Database
DATABASE_URL=postgresql://afrochef:afrochef@localhost:5432/afrochef?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Stripe Connect (backend-only secrets; never expose these to Expo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_PAYMENTS_ENABLED=false
CHECKOUT_RETURN_URL=https://afrochop.example
STRIPE_CONNECT_RETURN_URL=https://afrochop.example/chef/payments/return
STRIPE_CONNECT_REFRESH_URL=https://afrochop.example/api/payments/chef/connect/refresh

# Local development only: skip quote/booking compliance gates (compliance rules,
# verification, chef approval, Stripe eligibility). Ignored when NODE_ENV=production.
DEV_SKIP_COMPLIANCE=false

# Verification providers remain disabled until legal, privacy, and vendor review
IDENTITY_VERIFICATION_ENABLED=false
BACKGROUND_SCREENING_ENABLED=false
ADDRESS_VERIFICATION_ENABLED=false
# Generate a unique 32-byte key per environment; store in secrets manager, not source control
VERIFICATION_ENCRYPTION_KEY=

# Twilio SMS order updates (leave unset to disable SMS delivery)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Twilio Verify service with SMS enabled and a configured email integration.
TWILIO_VERIFY_SERVICE_SID=

# Staff cook-application alerts (backend only; comma-separated opted-in recipients).
STAFF_APPLICATION_EMAILS=
STAFF_APPLICATION_SMS_NUMBERS=
# Plain sender address verified in Amazon SES in AWS_REGION.
STAFF_ALERTS_FROM_EMAIL=
AWS_REGION=us-east-2
# Prefer an IAM runtime role. Outside AWS, supply dedicated SES credentials securely.
# These must have ses:SendEmail permission; never reuse seller-photo credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Google Sheets marketing-contact export (API only; grant this service account
# Editor access to the destination spreadsheet before enabling).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Contacts
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Seller photo storage (API only; never use EXPO_PUBLIC_ for credentials).
# Use a dedicated upload identity, not the AWS provisioning user.
SELLER_PHOTOS_BUCKET=afrochop
SELLER_PHOTOS_REGION=us-east-2
SELLER_PHOTOS_PUBLIC_URL=https://d2jbz102fyu4za.cloudfront.net
SELLER_PHOTOS_ENDPOINT=
SELLER_PHOTOS_ACCESS_KEY_ID=
SELLER_PHOTOS_SECRET_ACCESS_KEY=

# Expo app config
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_APP_NAME=AfroChop
